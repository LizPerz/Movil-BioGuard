# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8

# Wearable / Google Play Services
-keep class com.google.android.gms.wearable.** { *; }
-dontwarn com.google.android.gms.wearable.**

# WearableConnector DTOs
-keep class com.bioguard.movil.service.WatchEventDto { *; }
-keep class com.bioguard.movil.service.WatchAlertDto { *; }
-keep class com.bioguard.movil.service.RiskThresholds { *; }
-keep class com.bioguard.movil.service.WearableDeviceInfo { *; }
-keep class com.bioguard.movil.service.WearableConnectionState { *; }

# WebView (if needed in future)
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}
